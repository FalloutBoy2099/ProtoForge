<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ProtoForge.UI.Controls"
    xmlns:fields="clr-namespace:ProtoForge.UI.ViewModels.Fields"
    xmlns:loc="clr-namespace:ProtoForge.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!--  Number  -->
    <DataTemplate DataType="{x:Type fields:NumberFieldViewModel}">
        <StackPanel
            Width="150"
            Margin="0,0,8,5"
            ToolTip="{Binding Tooltip}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource MixedBadge}" Visibility="{Binding IsMixed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ui:NumberBox
                AutomationProperties.Name="{Binding Label}"
                ClearButtonEnabled="False"
                IsEnabled="{Binding IsEnabled}"
                MaxDecimalPlaces="0"
                PlaceholderText="{Binding Placeholder}"
                SpinButtonPlacementMode="Hidden"
                Value="{Binding Number, Mode=TwoWay}" />
        </StackPanel>
    </DataTemplate>

    <!--  Light intensity  -->
    <DataTemplate DataType="{x:Type fields:LightFieldViewModel}">
        <StackPanel
            Width="150"
            Margin="0,0,8,5"
            ToolTip="{Binding Tooltip}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource MixedBadge}" Visibility="{Binding IsMixed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Grid>
                <ui:NumberBox
                    AutomationProperties.Name="{Binding Label}"
                    ClearButtonEnabled="False"
                    IsEnabled="{Binding IsEnabled}"
                    MaxDecimalPlaces="1"
                    Maximum="100"
                    Minimum="0"
                    SpinButtonPlacementMode="Hidden"
                    Value="{Binding Percent, Mode=TwoWay}" />
                <TextBlock
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    IsHitTestVisible="False"
                    Text="%" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!--  Character / sound code  -->
    <DataTemplate DataType="{x:Type fields:CharacterFieldViewModel}">
        <StackPanel
            Width="150"
            Margin="0,0,8,5"
            ToolTip="{Binding Tooltip}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <ui:NumberBox
                    ClearButtonEnabled="False"
                    IsEnabled="{Binding IsEnabled}"
                    MaxDecimalPlaces="0"
                    Maximum="255"
                    Minimum="0"
                    SpinButtonPlacementMode="Hidden"
                    Value="{Binding Code, Mode=TwoWay}" />
                <ui:TextBox
                    Grid.Column="2"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding IsEnabled}"
                    MaxLength="1"
                    Text="{Binding Character, Mode=TwoWay}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!--  Choice  -->
    <DataTemplate DataType="{x:Type fields:ChoiceFieldViewModel}">
        <StackPanel
            Width="150"
            Margin="0,0,8,5"
            ToolTip="{Binding Tooltip}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource MixedBadge}" Visibility="{Binding IsMixed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ComboBox
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{Binding Label}"
                IsEnabled="{Binding IsEnabled}"
                ItemsSource="{Binding Options}"
                MaxDropDownHeight="360"
                SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
        </StackPanel>
    </DataTemplate>

    <!--  Prototype reference  -->
    <DataTemplate DataType="{x:Type fields:ProtoReferenceFieldViewModel}">
        <StackPanel
            Width="308"
            Margin="0,0,8,5"
            ToolTip="{Binding Tooltip}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource MixedBadge}" Visibility="{Binding IsMixed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ComboBox
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{Binding Label}"
                IsEnabled="{Binding IsEnabled}"
                ItemsSource="{Binding Options}"
                MaxDropDownHeight="360"
                SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
        </StackPanel>
    </DataTemplate>

    <!--  Script  -->
    <DataTemplate DataType="{x:Type fields:ScriptFieldViewModel}">
        <StackPanel
            Width="308"
            Margin="0,0,8,5"
            ToolTip="{Binding Tooltip}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource MixedBadge}" Visibility="{Binding IsMixed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ComboBox
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{Binding Label}"
                IsEnabled="{Binding IsEnabled}"
                ItemsSource="{Binding Options}"
                MaxDropDownHeight="360"
                SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
        </StackPanel>
    </DataTemplate>

    <!--  Art (frame id) with preview  -->
    <DataTemplate DataType="{x:Type fields:ArtFieldViewModel}">
        <StackPanel
            Width="308"
            Margin="0,0,8,5"
            ToolTip="{Binding Tooltip}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource MixedBadge}" Visibility="{Binding IsMixed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="52"
                    Height="38"
                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <Image
                        Margin="2"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Source="{Binding Preview}"
                        Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{Binding Label}"
                        IsEnabled="{Binding IsEnabled}"
                        ItemsSource="{Binding Options}"
                        MaxDropDownHeight="360"
                        SelectedItem="{Binding Selected, Mode=TwoWay}">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <TextBlock
                        Margin="2,4,0,0"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding FidText}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!--  Flags  -->
    <DataTemplate DataType="{x:Type fields:FlagsFieldViewModel}">
        <StackPanel
            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            Margin="0,0,0,6"
            ToolTip="{Binding Tooltip}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                    <TextBlock Style="{StaticResource MixedBadge}" Visibility="{Binding IsMixed, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Margin="12,0,0,3"
                        FontSize="11"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{Binding UnknownBits}" />
                </StackPanel>
                <ui:TextBox
                    Grid.Column="1"
                    Width="120"
                    Padding="6,2"
                    HorizontalContentAlignment="Right"
                    FontFamily="Consolas"
                    IsEnabled="{Binding IsEnabled}"
                    Text="{Binding HexText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <ItemsControl IsEnabled="{Binding IsEnabled}" ItemsSource="{Binding Flags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:ColumnsPanel
                            ItemHeight="24"
                            MaxColumns="4"
                            MinColumns="2"
                            MinItemWidth="190" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Label}"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            IsThreeState="False"
                            ToolTip="{Binding Tooltip}">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!--  Base / bonus / total row  -->
    <DataTemplate DataType="{x:Type fields:StatRowViewModel}">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" SharedSizeGroup="StatLabel" />
                <ColumnDefinition Width="80" SharedSizeGroup="StatBase" />
                <ColumnDefinition Width="80" SharedSizeGroup="StatBonus" />
                <ColumnDefinition Width="50" SharedSizeGroup="StatTotal" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding Label}"
                ToolTip="{Binding Base.Tooltip}" />
            <ui:NumberBox
                Grid.Column="1"
                Margin="0,0,8,0"
                ClearButtonEnabled="False"
                IsEnabled="{Binding Base.IsEnabled}"
                MaxDecimalPlaces="0"
                PlaceholderText="{Binding Base.Placeholder}"
                SpinButtonPlacementMode="Hidden"
                Value="{Binding Base.Number, Mode=TwoWay}" />
            <ui:NumberBox
                Grid.Column="2"
                Margin="0,0,8,0"
                ClearButtonEnabled="False"
                IsEnabled="{Binding Bonus.IsEnabled}"
                MaxDecimalPlaces="0"
                PlaceholderText="{Binding Bonus.Placeholder}"
                SpinButtonPlacementMode="Hidden"
                Value="{Binding Bonus.Number, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding Total}" />
        </Grid>
    </DataTemplate>

    <!--  Skill: stored adjustment, value computed from SPECIAL, total  -->
    <DataTemplate DataType="{x:Type fields:SkillRowViewModel}">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" SharedSizeGroup="SkillLabel" />
                <ColumnDefinition Width="80" SharedSizeGroup="SkillStored" />
                <ColumnDefinition Width="60" SharedSizeGroup="SkillFormula" />
                <ColumnDefinition Width="50" SharedSizeGroup="SkillTotal" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding Label}"
                ToolTip="{Binding Stored.Tooltip}" />
            <ui:NumberBox
                Grid.Column="1"
                Margin="0,0,8,0"
                ClearButtonEnabled="False"
                IsEnabled="{Binding Stored.IsEnabled}"
                MaxDecimalPlaces="0"
                PlaceholderText="{Binding Stored.Placeholder}"
                SpinButtonPlacementMode="Hidden"
                Value="{Binding Stored.Number, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Formula}" />
            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding Total}" />
        </Grid>
    </DataTemplate>

    <!--  A group of fields (or a stat table)  -->
    <DataTemplate DataType="{x:Type fields:FieldGroupViewModel}">
        <ui:CardExpander
            Margin="0,0,0,6"
            ContentPadding="10,8,10,2"
            IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <ui:CardExpander.Header>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Header}" />
            </ui:CardExpander.Header>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel
                    Margin="0,0,0,10"
                    Grid.IsSharedSizeScope="True"
                    Visibility="{Binding IsStatTable, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" SharedSizeGroup="StatLabel" />
                            <ColumnDefinition Width="80" SharedSizeGroup="StatBase" />
                            <ColumnDefinition Width="80" SharedSizeGroup="StatBonus" />
                            <ColumnDefinition Width="50" SharedSizeGroup="StatTotal" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource FieldLabel}"
                            Text="{loc:Loc stats.base}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource FieldLabel}"
                            Text="{loc:Loc stats.bonus}" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            Style="{StaticResource FieldLabel}"
                            Text="{loc:Loc stats.total}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding StatRows}" />
                </StackPanel>
                <StackPanel
                    Margin="0,0,0,10"
                    Grid.IsSharedSizeScope="True"
                    Visibility="{Binding IsSkillTable, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" SharedSizeGroup="SkillLabel" />
                            <ColumnDefinition Width="80" SharedSizeGroup="SkillStored" />
                            <ColumnDefinition Width="60" SharedSizeGroup="SkillFormula" />
                            <ColumnDefinition Width="50" SharedSizeGroup="SkillTotal" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource FieldLabel}"
                            Text="{loc:Loc stats.stored}" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            Style="{StaticResource FieldLabel}"
                            Text="{loc:Loc stats.formula}" />
                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Center"
                            Style="{StaticResource FieldLabel}"
                            Text="{loc:Loc stats.total}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SkillRows}" />
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>
    </DataTemplate>

</ResourceDictionary>