<Page
    x:Class="ProtoForge.UI.Views.BalancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ProtoForge.UI.Controls"
    xmlns:loc="clr-namespace:ProtoForge.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Balance"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <!--  A figure that stands out from the others is written in the caution color  -->
        <Style x:Key="OutlierNumber" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="12,4,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,8"
            Style="{StaticResource PageTitle}"
            Text="{loc:Loc balance.title}" />

        <TabControl
            Grid.Row="1"
            Padding="0"
            Background="Transparent">
            <TabItem Header="{loc:Loc balance.tables}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <ComboBox
                            Width="170"
                            Margin="0,0,8,0"
                            SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{loc:Loc balance.weapons}" />
                            <ComboBoxItem Content="{loc:Loc balance.armors}" />
                        </ComboBox>
                        <ui:Button Click="OnRefreshClick" Content="{loc:Loc balance.refresh}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedText}"
                            Text="{loc:Loc balance.hint}" />
                    </StackPanel>

                    <!--  Weapons  -->
                    <ui:DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="{loc:Loc balance.weapons}"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Weapons}"
                        MouseDoubleClick="OnRowDoubleClick"
                        SelectionMode="Single"
                        Visibility="{Binding ShowWeapons, Converter={StaticResource BoolToVisibility}}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="190"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc col.name}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Pid}"
                                ElementStyle="{StaticResource CellText}"
                                Header="PID" />
                            <DataGridTemplateColumn
                                Width="170"
                                Header="{loc:Loc balance.average}"
                                SortMemberPath="Average">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar
                                                Width="150"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Maximum="{Binding DataContext.MaxAverageDamage, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Minimum="0"
                                                Opacity="0.35"
                                                Value="{Binding Average, Mode=OneWay}" />
                                            <TextBlock Margin="4,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource OutlierNumber}" TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Average, StringFormat={}{0:0.#}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AverageIsOutlier}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding MinDamage}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.min}" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding MaxDamage}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.max}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding DamageType}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.damageType}" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Range}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.range}" />
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding ApCost}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.ap}" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Burst}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.burst}" />
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding Ammo}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.ammo}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Cost, StringFormat={}{0:N0}}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.cost}" />
                            <DataGridTemplateColumn
                                Width="100"
                                Header="{loc:Loc balance.costPerDamage}"
                                SortMemberPath="CostPerDamage">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource OutlierNumber}" TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding CostPerDamage, StringFormat={}{0:N1}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CostPerDamageIsOutlier}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn
                                Width="100"
                                Header="{loc:Loc balance.damagePerAp}"
                                SortMemberPath="DamagePerAp">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource OutlierNumber}" TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding DamagePerAp, StringFormat={}{0:N1}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DamagePerApIsOutlier}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Score}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.score}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Source}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc col.source}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>

                    <!--  Armors  -->
                    <ui:DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="{loc:Loc balance.armors}"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Armors}"
                        MouseDoubleClick="OnRowDoubleClick"
                        SelectionMode="Single"
                        Visibility="{Binding ShowArmors, Converter={StaticResource BoolToVisibility}}">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="190"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc col.name}" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Pid}"
                                ElementStyle="{StaticResource CellText}"
                                Header="PID" />
                            <DataGridTemplateColumn
                                Width="190"
                                Header="{loc:Loc balance.score}"
                                SortMemberPath="Score">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar
                                                Width="150"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Maximum="{Binding DataContext.MaxArmorScore, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Minimum="0"
                                                Opacity="0.35"
                                                Value="{Binding Score, Mode=OneWay}" />
                                            <TextBlock Margin="4,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource OutlierNumber}" TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Score}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ScoreIsOutlier}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding ArmorClass}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.armorClass}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding AverageDt, StringFormat={}{0:0.#}}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.averageDt}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding AverageDr, StringFormat={}{0:0.#}}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.averageDr}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Cost, StringFormat={}{0:N0}}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc balance.cost}" />
                            <DataGridTemplateColumn
                                Width="110"
                                Header="{loc:Loc balance.costPerScore}"
                                SortMemberPath="CostPerScore">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource OutlierNumber}" TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding CostPerScore, StringFormat={}{0:N1}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CostPerScoreIsOutlier}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Source}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc col.source}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc balance.matrix}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource MutedText}"
                        Text="{loc:Loc balance.matrixHint}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        Orientation="Horizontal">
                        <ComboBox
                            Width="280"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="{loc:Loc balance.matrix}"
                            SelectedIndex="{Binding MatrixMetricIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{loc:Loc balance.matrixPerAttack}" />
                            <ComboBoxItem Content="{loc:Loc balance.matrixPerAp}" />
                        </ComboBox>
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="{loc:Loc balance.matrixBurst}"
                            IsChecked="{Binding MatrixBurst, Mode=TwoWay}" />
                    </StackPanel>
                    <ui:DataGrid
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        AutomationProperties.Name="{loc:Loc balance.matrix}"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding MatrixRows}"
                        MouseDoubleClick="OnMatrixDoubleClick"
                        SelectionMode="Single">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn
                                Width="190"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource CellText}"
                                Header="{loc:Loc col.name}" />
                            <DataGridTextColumn
                                x:Name="MatrixColumn0"
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding V0, StringFormat={}{0:0.#}}"
                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn
                                x:Name="MatrixColumn1"
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding V1, StringFormat={}{0:0.#}}"
                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn
                                x:Name="MatrixColumn2"
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding V2, StringFormat={}{0:0.#}}"
                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn
                                x:Name="MatrixColumn3"
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding V3, StringFormat={}{0:0.#}}"
                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn
                                x:Name="MatrixColumn4"
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding V4, StringFormat={}{0:0.#}}"
                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn
                                x:Name="MatrixColumn5"
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding V5, StringFormat={}{0:0.#}}"
                                ElementStyle="{StaticResource CellText}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc balance.simulation}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="760"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left">
                        <TextBlock
                            Margin="0,0,0,12"
                            Style="{StaticResource MutedText}"
                            Text="{loc:Loc balance.simHint}"
                            TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.weapon}" />
                                <controls:EntryPicker
                                    Margin="0,0,0,10"
                                    Entries="{Binding WeaponEntries}"
                                    SelectedEntry="{Binding SimWeapon, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.ammo}" />
                                <controls:EntryPicker
                                    Margin="0,0,0,10"
                                    Entries="{Binding AmmoEntries}"
                                    SelectedEntry="{Binding SimAmmo, Mode=TwoWay}" />
                                <CheckBox
                                    Content="{loc:Loc balance.sim.burst}"
                                    IsChecked="{Binding SimBurst, Mode=TwoWay}"
                                    ToolTip="{loc:Loc balance.sim.burstTip}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.target}" />
                                <controls:EntryPicker
                                    Margin="0,0,0,10"
                                    Entries="{Binding TargetEntries}"
                                    SelectedEntry="{Binding SimTarget, Mode=TwoWay}" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.thresholdOverride}" />
                                        <ui:NumberBox
                                            Width="110"
                                            MaxDecimalPlaces="0"
                                            Minimum="0"
                                            SpinButtonPlacementMode="Hidden"
                                            Value="{Binding SimThreshold, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.resistanceOverride}" />
                                        <ui:NumberBox
                                            Width="110"
                                            MaxDecimalPlaces="0"
                                            Maximum="100"
                                            Minimum="0"
                                            SpinButtonPlacementMode="Hidden"
                                            Value="{Binding SimResistance, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.hpOverride}" />
                                        <ui:NumberBox
                                            Width="110"
                                            MaxDecimalPlaces="0"
                                            Minimum="0"
                                            SpinButtonPlacementMode="Hidden"
                                            Value="{Binding SimHitPoints, Mode=TwoWay}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,8,0,6"
                            Style="{StaticResource SectionTitle}"
                            Text="{loc:Loc balance.sim.attacker}" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.skill}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="0"
                                    Maximum="300"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Hidden"
                                    ToolTip="{loc:Loc balance.sim.skillTip}"
                                    Value="{Binding SimSkill, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.perception}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="0"
                                    Maximum="10"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Hidden"
                                    Value="{Binding SimPerception, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.strength}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="0"
                                    Maximum="10"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Hidden"
                                    Value="{Binding SimStrength, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.luck}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="0"
                                    Maximum="10"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Hidden"
                                    Value="{Binding SimLuck, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.distance}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="0"
                                    Maximum="60"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Hidden"
                                    Value="{Binding SimDistance, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.armorClass}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="0"
                                    Maximum="999"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Hidden"
                                    ToolTip="{loc:Loc balance.sim.armorClassTip}"
                                    Value="{Binding SimArmorClass, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.criticalChance}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="0"
                                    Maximum="100"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Hidden"
                                    ToolTip="{loc:Loc balance.sim.criticalChanceTip}"
                                    Value="{Binding SimCriticalChance, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.damageBonus}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="0"
                                    Maximum="99"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Hidden"
                                    ToolTip="{loc:Loc balance.sim.damageBonusTip}"
                                    Value="{Binding SimDamageBonus, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.location}" />
                                <ComboBox
                                    Width="150"
                                    AutomationProperties.Name="{loc:Loc balance.sim.location}"
                                    SelectedIndex="{Binding SimLocationIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{loc:Loc balance.sim.locUncalled}" />
                                    <ComboBoxItem Content="{loc:Loc balance.sim.locHead}" />
                                    <ComboBoxItem Content="{loc:Loc balance.sim.locArm}" />
                                    <ComboBoxItem Content="{loc:Loc balance.sim.locLeg}" />
                                    <ComboBoxItem Content="{loc:Loc balance.sim.locEyes}" />
                                    <ComboBoxItem Content="{loc:Loc balance.sim.locGroin}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.weaponPerk}" />
                                <ComboBox
                                    Width="200"
                                    AutomationProperties.Name="{loc:Loc balance.sim.weaponPerk}"
                                    SelectedIndex="{Binding SimPerkIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{loc:Loc balance.sim.perkNone}" />
                                    <ComboBoxItem Content="{loc:Loc balance.sim.perkAccurate}" />
                                    <ComboBoxItem Content="{loc:Loc balance.sim.perkLongRange}" />
                                    <ComboBoxItem Content="{loc:Loc balance.sim.perkScopeRange}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.criticalMultiplier}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="1"
                                    Maximum="6"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Hidden"
                                    ToolTip="{loc:Loc balance.sim.criticalMultiplierTip}"
                                    Value="{Binding SimCriticalMultiplier, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Loc balance.sim.sharpshooter}" />
                                <ui:NumberBox
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    MaxDecimalPlaces="0"
                                    Maximum="3"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Hidden"
                                    Value="{Binding SimSharpshooter, Mode=TwoWay}" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox
                                Margin="0,0,16,0"
                                Content="{loc:Loc balance.sim.player}"
                                IsChecked="{Binding SimPlayer, Mode=TwoWay}"
                                ToolTip="{loc:Loc balance.sim.playerTip}" />
                            <CheckBox
                                Content="{loc:Loc balance.sim.sniper}"
                                IsChecked="{Binding SimSniper, Mode=TwoWay}"
                                ToolTip="{loc:Loc balance.sim.sniperTip}" />
                        </WrapPanel>

                        <Border
                            Margin="0,8,0,0"
                            Padding="12,8"
                            Style="{StaticResource CardPanel}">
                            <ItemsControl ItemsSource="{Binding SimLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="310" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Label}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontWeight="SemiBold"
                                                Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock
                            Margin="0,10,0,0"
                            FontSize="11"
                            Style="{StaticResource MutedText}"
                            Text="{loc:Loc balance.sim.note}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>

</Page>