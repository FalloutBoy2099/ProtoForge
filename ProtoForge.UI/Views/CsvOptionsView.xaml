<UserControl
    x:Class="ProtoForge.UI.Views.CsvOptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:ProtoForge.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <StackPanel Width="520">
        <TextBlock
            Margin="0,0,0,10"
            Text="{Binding Summary}"
            TextWrapping="Wrap" />
        <CheckBox
            Content="{loc:Loc csv.readable}"
            IsChecked="{Binding Readable, Mode=TwoWay}"
            ToolTip="{loc:Loc csv.readableTip}" />
        <TextBlock
            Margin="26,0,0,10"
            FontSize="12"
            Style="{StaticResource MutedText}"
            Text="{loc:Loc csv.readableTip}"
            TextWrapping="Wrap" />
        <DockPanel Margin="0,0,0,6">
            <ui:Button
                Margin="6,0,0,0"
                Click="OnSelectNone"
                Content="{loc:Loc csv.none}"
                DockPanel.Dock="Right" />
            <ui:Button
                Click="OnSelectAll"
                Content="{loc:Loc csv.all}"
                DockPanel.Dock="Right" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource FieldLabel}"
                Text="{loc:Loc csv.columns}" />
        </DockPanel>
        <ListBox
            MaxHeight="300"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            ItemsSource="{Binding Columns}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox
                        Width="236"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        ToolTip="{Binding Key}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>

</UserControl>