<ui:FluentWindow
    x:Class="ProtoForge.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:ProtoForge.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:ProtoForge.UI.Views"
    Title="{Binding Title}"
    Width="1180"
    Height="740"
    MinWidth="900"
    MinHeight="520"
    AllowDrop="True"
    ExtendsContentIntoTitleBar="True"
    FontSize="12"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding
            Key="O"
            Command="{Binding OpenGameFolderCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Z"
            Command="{Binding UndoCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Y"
            Command="{Binding RedoCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Z"
            Command="{Binding RedoCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="F"
            Command="{Binding FocusSearchCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="E"
            Command="{Binding FocusSearchCommand}"
            Modifiers="Ctrl" />
    </Window.InputBindings>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding Title}"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True">
			<ui:TitleBar.Icon>
				<ui:ImageIcon Source="pack://application:,,,/ProtoForge;component/Assets/icon.png" />
			</ui:TitleBar.Icon>
			<ui:TitleBar.CenterContent>
				<ui:TextBox
                    x:Name="SearchBox"
                    Width="380"
                    Margin="0,2"
                    ClearButtonEnabled="True"
                    PlaceholderText="{loc:Loc search.placeholder}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{loc:Loc search.tooltip}">
					<ui:TextBox.Icon>
						<ui:SymbolIcon Symbol="Search24" />
					</ui:TextBox.Icon>
				</ui:TextBox>
			</ui:TitleBar.CenterContent>
			<ui:TitleBar.TrailingContent>
				<StackPanel Orientation="Horizontal">
					<ui:Button
                        x:Name="ThemeButton"
                        Margin="0,0,2,0"
                        Padding="8,4"
                        Appearance="Transparent"
                        AutomationProperties.Name="{loc:Loc theme.tip}"
                        Click="OnThemeButtonClick"
                        ToolTip="{loc:Loc theme.tip}">
						<ui:SymbolIcon Symbol="WeatherMoon24" />
					</ui:Button>
					<ui:Button
                        x:Name="LanguageButton"
                        Margin="0,0,6,0"
                        Padding="8,4"
                        Appearance="Transparent"
                        AutomationProperties.Name="{loc:Loc language.tip}"
                        Click="OnLanguageButtonClick"
                        ToolTip="{loc:Loc language.tip}">
						<ui:SymbolIcon Symbol="LocalLanguage24" />
					</ui:Button>
				</StackPanel>
			</ui:TitleBar.TrailingContent>
		</ui:TitleBar>

		<!--  Global commands  -->
		<StackPanel
            Grid.Row="1"
            Margin="8,0,8,4"
            Orientation="Horizontal">
			<ui:DropDownButton
                Margin="0,0,6,0"
                Content="{loc:Loc cmd.open}"
                ToolTip="Ctrl+O">
				<ui:DropDownButton.Icon>
					<ui:SymbolIcon Symbol="FolderOpen24" />
				</ui:DropDownButton.Icon>
				<ui:DropDownButton.Flyout>
					<ContextMenu>
						<MenuItem
                            Command="{Binding OpenGameFolderCommand}"
                            Header="{loc:Loc open.gameFolder}"
                            InputGestureText="Ctrl+O">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Folder24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Command="{Binding OpenModFolderCommand}" Header="{loc:Loc open.modFolder}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="Box24" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Command="{Binding OpenDatArchiveCommand}" Header="{loc:Loc open.datFile}">
							<MenuItem.Icon>
								<ui:SymbolIcon Symbol="DocumentArrowLeft24" />
							</MenuItem.Icon>
						</MenuItem>
						<Separator />
						<MenuItem
                            x:Name="RecentMenu"
                            Header="{loc:Loc open.recent}"
                            ItemsSource="{Binding RecentProjects}">
							<MenuItem.ItemContainerStyle>
								<Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
									<Setter Property="Header" Value="{Binding Name}" />
									<Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=views:MainWindow}}" />
									<Setter Property="CommandParameter" Value="{Binding}" />
								</Style>
							</MenuItem.ItemContainerStyle>
						</MenuItem>
					</ContextMenu>
				</ui:DropDownButton.Flyout>
			</ui:DropDownButton>

			<ui:Button
                Margin="0,0,6,0"
                Appearance="Primary"
                Command="{Binding SaveCommand}"
                Content="{loc:Loc cmd.save}"
                ToolTip="Ctrl+S">
				<ui:Button.Icon>
					<ui:SymbolIcon Symbol="Save24" />
				</ui:Button.Icon>
			</ui:Button>
			<ui:Button
                Margin="0,0,2,0"
                AutomationProperties.Name="{Binding UndoTooltip}"
                Command="{Binding UndoCommand}"
                ToolTip="{Binding UndoTooltip}">
				<ui:SymbolIcon Symbol="ArrowUndo24" />
			</ui:Button>
			<ui:Button
                Margin="0,0,10,0"
                AutomationProperties.Name="{Binding RedoTooltip}"
                Command="{Binding RedoCommand}"
                ToolTip="{Binding RedoTooltip}">
				<ui:SymbolIcon Symbol="ArrowRedo24" />
			</ui:Button>
			<ui:Button
                Margin="0,0,2,0"
                AutomationProperties.Name="{loc:Loc cmd.reload}"
                Command="{Binding ReloadCommand}"
                ToolTip="{loc:Loc cmd.reload}">
				<ui:SymbolIcon Symbol="ArrowSync24" />
			</ui:Button>
			<ui:Button
                AutomationProperties.Name="{loc:Loc cmd.close}"
                Command="{Binding CloseProjectCommand}"
                ToolTip="{loc:Loc cmd.close}">
				<ui:SymbolIcon Symbol="Dismiss24" />
			</ui:Button>
		</StackPanel>

		<ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="2"
            CompactPaneLength="40"
            FontSize="12"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="168"
            PaneDisplayMode="Left">
			<ui:NavigationView.MenuItems>
				<ui:NavigationViewItem Content="{loc:Loc nav.library}" TargetPageType="{x:Type views:LibraryPage}">
					<ui:NavigationViewItem.Icon>
						<ui:SymbolIcon Symbol="Library24" />
					</ui:NavigationViewItem.Icon>
				</ui:NavigationViewItem>
				<ui:NavigationViewItem Content="{loc:Loc nav.compare}" TargetPageType="{x:Type views:ComparePage}">
					<ui:NavigationViewItem.Icon>
						<ui:SymbolIcon Symbol="ArrowSwap24" />
					</ui:NavigationViewItem.Icon>
				</ui:NavigationViewItem>
				<ui:NavigationViewItem Content="{loc:Loc nav.validation}" TargetPageType="{x:Type views:ValidationPage}">
					<ui:NavigationViewItem.Icon>
						<ui:SymbolIcon Symbol="ShieldCheckmark24" />
					</ui:NavigationViewItem.Icon>
				</ui:NavigationViewItem>
				<ui:NavigationViewItem Content="{loc:Loc nav.messages}" TargetPageType="{x:Type views:MessagesPage}">
					<ui:NavigationViewItem.Icon>
						<ui:SymbolIcon Symbol="TextBulletListLtr24" />
					</ui:NavigationViewItem.Icon>
				</ui:NavigationViewItem>
				<ui:NavigationViewItem Content="{loc:Loc nav.ai}" TargetPageType="{x:Type views:AiPacketsPage}">
					<ui:NavigationViewItem.Icon>
						<ui:SymbolIcon Symbol="Bot24" />
					</ui:NavigationViewItem.Icon>
				</ui:NavigationViewItem>
				<ui:NavigationViewItem Content="{loc:Loc nav.tools}" TargetPageType="{x:Type views:ToolsPage}">
					<ui:NavigationViewItem.Icon>
						<ui:SymbolIcon Symbol="Wrench24" />
					</ui:NavigationViewItem.Icon>
				</ui:NavigationViewItem>
			</ui:NavigationView.MenuItems>
			<ui:NavigationView.FooterMenuItems>
				<ui:NavigationViewItem Content="{loc:Loc nav.settings}" TargetPageType="{x:Type views:SettingsPage}">
					<ui:NavigationViewItem.Icon>
						<ui:SymbolIcon Symbol="Settings24" />
					</ui:NavigationViewItem.Icon>
				</ui:NavigationViewItem>
				<ui:NavigationViewItem Content="{loc:Loc nav.about}" TargetPageType="{x:Type views:AboutPage}">
					<ui:NavigationViewItem.Icon>
						<ui:SymbolIcon Symbol="Info24" />
					</ui:NavigationViewItem.Icon>
				</ui:NavigationViewItem>
			</ui:NavigationView.FooterMenuItems>
		</ui:NavigationView>

		<!--  Status bar  -->
		<Border
            Grid.Row="3"
            Padding="10,2"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusText}"
                    TextTrimming="CharacterEllipsis" />
				<TextBlock
                    Grid.Column="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{Binding ModifiedText}" />
			</Grid>
		</Border>

		<!--  Overlays  -->
		<ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Grid.Row="2"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom" />
		<ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="4" />

		<Grid
            Grid.RowSpan="4"
            Background="#99000000"
            Visibility="{Binding Workspace.IsBusy, Converter={StaticResource BoolToVisibility}}">
			<Border
                Width="380"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Style="{StaticResource CardPanel}">
				<StackPanel>
					<ui:ProgressRing
                        Width="42"
                        Height="42"
                        Margin="0,0,0,14"
                        IsIndeterminate="True" />
					<TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        Text="{Binding Workspace.BusyText}" />
					<ProgressBar
                        Height="4"
                        Maximum="1"
                        Minimum="0"
                        Value="{Binding Workspace.BusyProgress, Mode=OneWay}" />
				</StackPanel>
			</Border>
		</Grid>
	</Grid>

</ui:FluentWindow>