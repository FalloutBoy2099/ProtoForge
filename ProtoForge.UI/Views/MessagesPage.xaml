<Page
    x:Class="ProtoForge.UI.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:ProtoForge.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Messages"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <Grid Margin="12,4,12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource PageTitle}"
                Text="{loc:Loc messages.title}" />
            <ListBox
                Grid.Row="1"
                DisplayMemberPath="Display"
                ItemsSource="{Binding Files}"
                SelectedItem="{Binding SelectedFile, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,4,0,10" LastChildFill="True">
                <ui:Button
                    Margin="6,0,0,0"
                    AutomationProperties.Name="{loc:Loc cmd.delete}"
                    Command="{Binding DeleteMessageCommand}"
                    DockPanel.Dock="Right"
                    ToolTip="{loc:Loc cmd.delete}">
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:Button>
                <ui:Button
                    Margin="6,0,0,0"
                    Command="{Binding AddMessageCommand}"
                    Content="{loc:Loc messages.add}"
                    DockPanel.Dock="Right">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:TextBox
                    ClearButtonEnabled="True"
                    PlaceholderText="{loc:Loc messages.filter}"
                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <ui:DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                EnableRowVirtualization="True"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                ItemsSource="{Binding View}"
                RowHeight="NaN"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                SelectionMode="Single"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Id}"
                        ElementStyle="{StaticResource CellText}"
                        Header="ID"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Audio, UpdateSourceTrigger=LostFocus}"
                        ElementStyle="{StaticResource CellText}"
                        Header="{loc:Loc messages.audio}" />
                    <DataGridTextColumn
                        x:Name="TextColumn"
                        Width="*"
                        Binding="{Binding Text, UpdateSourceTrigger=LostFocus}"
                        Header="{loc:Loc messages.text}">
                        <DataGridTextColumn.ElementStyle>
                            <StaticResource ResourceKey="WrapCellText" />
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="AcceptsReturn" Value="False" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        x:Name="DescriptionColumn"
                        Width="2*"
                        Binding="{Binding Description, UpdateSourceTrigger=LostFocus}"
                        ElementStyle="{StaticResource WrapCellText}"
                        Header="{loc:Loc field.description}"
                        Visibility="Collapsed">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="AcceptsReturn" Value="False" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <TextBlock
                Grid.Row="2"
                Margin="2,8,0,0"
                FontSize="12"
                Style="{StaticResource MutedText}"
                Text="{Binding Status}" />
        </Grid>
    </Grid>

</Page>